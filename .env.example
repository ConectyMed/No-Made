# Copier en .env pour le développement local. Sur Vercel : Project → Settings → Environment Variables.
# Aucune de ces variables n'est nécessaire avant le jalon M3 (formulaire de contact).

# --- Envoi d'email (Resend) ---
RESEND_API_KEY=
# Adresse qui reçoit les demandes de session
CONTACT_TO_EMAIL=nomadeproject@outlook.fr
# Expéditeur : doit être sur un domaine vérifié chez Resend. Sans domaine : onboarding@resend.dev (tests uniquement)
CONTACT_FROM_EMAIL=

# --- Anti-spam (optionnel) : Cloudflare Turnstile s'active seulement si les deux clés sont présentes ---
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Build ---
# Adresse publique du site, sans barre finale (ex. https://exemple.fr). Sert au canonical, à og:url, og:image,
# au sitemap et à robots.txt. Absente : domaine provisoire https://nomade-project.example, signalé comme placeholder.
PUBLIC_SITE_URL=
# Mettre à 1 pour autoriser un build de production avec des [PLACEHOLDERS] restants (prévisualisations)
ALLOW_PLACEHOLDERS=

# --- Base de données (admin / mini CRM) ---
# Sur Vercel : Storage → Turso installe ces deux variables tout seul. En local : rien, data/dev.db est utilisé.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Adresses autorisées à créer leur mot de passe depuis /admin/mot-de-passe (première connexion), séparées par des virgules
ADMIN_EMAILS=
# Compte de démarrage, créé à la première connexion tant qu'aucun compte n'existe (défaut : admin / admin123, temporaire)
ADMIN_BOOTSTRAP_USER=
ADMIN_BOOTSTRAP_PASSWORD=
