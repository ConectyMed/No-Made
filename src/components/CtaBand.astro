---
/**
 * Bandeau d'appel en bas de page : « Demander une session » + « Réserver un créneau visio », sur fond sombre.
 * Même bloc que sur Encadrement ; utilisé sur Ma philosophie et chaque article.
 */
import Button from './Button.astro';
import { CTA_LABEL, CTA_HREF, VISIO_LABEL, VISIO_HREF } from '@/data/site';

interface Props {
  title: string;
  headingId: string;
  reveal?: boolean;
}
const { title, headingId, reveal = false } = Astro.props;
---

<section class="section" aria-labelledby={headingId}>
  <div class="container">
    <div class="cta frame" data-reveal={reveal ? '' : undefined}>
      <div>
        <h2 id={headingId} class="cta__title">{title}</h2>
        <p class="cta__text"><slot /></p>
      </div>
      <div class="cta__actions">
        <Button href={CTA_HREF} variant="lime" icon="arrow-right">{CTA_LABEL}</Button>
        <a href={VISIO_HREF} class="cta__link label">{VISIO_LABEL}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    display: grid;
    gap: var(--space-5);
    padding: clamp(1.5rem, 1rem + 3vw, 3rem);
    background: var(--deep);
    color: var(--on-dark);
  }

  .cta__title {
    color: var(--on-dark);
    font-size: var(--text-md);
    margin-bottom: var(--space-2);
  }

  .cta__text {
    color: var(--on-dark-muted);
    max-width: 44ch;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }

  .cta__link {
    color: var(--on-dark);
    text-underline-offset: 0.2em;
  }

  @media (min-width: 64em) {
    .cta {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
  }
</style>
