---
/** Petit label en pilule au-dessus d'un titre de section (design.md §3). */
interface Props {
  class?: string;
  /** Sur fond lime ou photo, passer 'contrast'. */
  tone?: 'default' | 'contrast';
}
const { class: className, tone = 'default' } = Astro.props;
---

<span class:list={['eyebrow', `eyebrow--${tone}`, className]}>
  <svg class="eyebrow__dot" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
    <path d="M5 0.6C7.4 0.6 9.4 2.6 9.4 5S7.4 9.4 5 9.4 0.6 7.4 0.6 5 2.6 0.6 5 0.6Zm0 1.6C3.2 4 3.2 6 5 7.8 6.8 6 6.8 4 5 2.2Z" fill="currentColor" />
  </svg>
  <slot />
</span>

<style>
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.4em 0.9em 0.4em 0.7em;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: var(--border);
    color: var(--moss);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
  }

  .eyebrow--contrast {
    background: rgba(255, 255, 255, 0.85);
    border-color: transparent;
  }

  .eyebrow__dot {
    flex: none;
  }
</style>
