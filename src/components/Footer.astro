---
/** Pied de page (design.md §6.8) : cadre teinté arrondi en haut, marque + une ligne, liens, copyright. */
import Placeholder from './Placeholder.astro';
import { site, nav, legalLinks } from '@/data/site';
import { t } from '@/i18n';

const year = new Date().getFullYear();
const links = [...nav.filter((n) => n.href !== '/'), { href: '/encadrement/', label: 'Encadrement et sécurité' }, ...legalLinks];
---

<footer class="footer">
  <div class="container footer__top">
    <div class="footer__brand">
      <a href="/" class="footer__name" aria-label={t('common.home')}>{site.name}</a>
      <p class="small muted">{site.tagline} {site.zone.charAt(0).toUpperCase() + site.zone.slice(1)}.</p>
    </div>

    <nav aria-label={t('common.footerNav')}>
      <ul class="footer__links" role="list">
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
        {site.social.map((s) => (
          <li>
            {s.label} : <Placeholder name={s.placeholder.replace(/^\[|\]$/g, '')} />
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="container footer__bottom small muted">
    <p>© {year} {site.name} — Région {site.area}. Tous droits réservés.</p>
    <p class="footer__contact">
      <span class="footer__dot" aria-hidden="true"></span>
      {site.email.startsWith('[') ? <Placeholder name={site.email.slice(1, -1)} /> : <a href={`mailto:${site.email}`}>{site.email}</a>}
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-10);
    background: var(--surface-low);
    border-top: var(--border);
    border-radius: var(--radius-frame) var(--radius-frame) 0 0;
  }

  .footer__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block: var(--space-9) var(--space-6);
  }

  .footer__brand {
    max-width: 26rem;
    display: grid;
    gap: var(--space-2);
  }

  .footer__name {
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--green-900);
    text-decoration: none;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    font-size: var(--label-sm);
    font-weight: 600;
    color: var(--ink-2);
  }

  .footer__links a {
    text-decoration: none;
    color: inherit;
    transition: color var(--dur-fast) ease;
  }

  .footer__links a:hover {
    color: var(--green-900);
    text-decoration: underline;
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-block: var(--space-4) var(--space-6);
    border-top: var(--border);
  }

  .footer__contact {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .footer__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--lime);
  }

  @media (min-width: 48em) {
    .footer__top {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
