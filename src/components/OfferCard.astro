---
/**
 * Carte d'offre : pilule catégorie, titre, résumé, durée / groupe / prix, puis en version détaillée
 * pour qui, programme, à prévoir. Bouton "Demander cette session".
 */
import type { CollectionEntry } from 'astro:content';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { formatPrice } from '@/lib/format';
import { t } from '@/i18n';

interface Props {
  offer: CollectionEntry<'offers'>;
  compact?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { offer, compact = false, headingLevel: H = 'h3' } = Astro.props;
const d = offer.data;
const requestHref = `/contact/?offre=${encodeURIComponent(d.slug)}#demande`;

/** "[NOM DU PARTENAIRE]" → marque de placeholder visible. */
const parts = (s: string) =>
  s.split(/(\[[^\]]+\])/g).map((p) => (/^\[[^\]]+\]$/.test(p) ? { ph: p.slice(1, -1) } : { text: p }));
---

<article class:list={['offer', 'card', 'card--hover', { 'offer--compact': compact }]} id={compact ? undefined : d.slug}>
  <header class="offer__head">
    <span class="offer__pill">{d.category}</span>
    <H class="offer__title">{d.title}</H>
    <p class="offer__summary muted">
      {parts(d.summary).map((p) => ('ph' in p ? <mark class="placeholder">[{p.ph}]</mark> : p.text))}
    </p>
  </header>

  <dl class="offer__facts">
    <div>
      <dt><Icon name="clock" size={16} /> Durée</dt>
      <dd>{d.duration}</dd>
    </div>
    <div>
      <dt><Icon name="users" size={16} /> Groupe</dt>
      <dd>{d.groupSize}</dd>
    </div>
    <div class="offer__price">
      <dt><Icon name="euro" size={16} /> Prix</dt>
      <dd>
        {d.pricing.map((p) => (
          <span class="offer__price-line">
            <strong>{formatPrice(p.amountCents)}</strong> <span class="muted">{p.label}</span>
          </span>
        ))}
      </dd>
    </div>
  </dl>

  {
    !compact && (
      <div class="offer__details">
        <div>
          <h4>Pour qui</h4>
          <p class="muted">{d.forWhom}</p>
        </div>
        <div>
          <h4>Au programme</h4>
          <ul>
            {d.includes.map((item) => (
              <li>{parts(item).map((p) => ('ph' in p ? <mark class="placeholder">[{p.ph}]</mark> : p.text))}</li>
            ))}
          </ul>
        </div>
        <div>
          <h4>À prévoir</h4>
          <ul>
            {d.bring.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    )
  }

  {
    d.partnerLed && (
      <p class="offer__partner small muted">
        La séquence mobilité est encadrée par{' '}
        {parts(d.partnerName ?? '').map((p) => ('ph' in p ? <mark class="placeholder">[{p.ph}]</mark> : p.text))}
        , éducateur diplômé. <a href="/a-propos/#partenaire">En savoir plus</a>
      </p>
    )
  }

  <footer class="offer__foot">
    <Button href={requestHref} variant="dark" icon="arrow-right">{t('common.requestThisSession')}</Button>
    {d.testPrice && <span class="small muted">Prix de test, susceptibles de changer.</span>}
  </footer>
</article>

<style>
  .offer {
    display: grid;
    gap: var(--space-5);
    padding: clamp(1.5rem, 1.2rem + 1.5vw, 2rem);
  }

  .offer__head {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .offer__pill {
    display: inline-block;
    padding: 0.35em 0.85em;
    border-radius: var(--radius-pill);
    background: var(--surface-low);
    border: var(--border);
    color: var(--green-600);
    font-size: var(--label-sm);
    font-weight: 600;
  }

  .offer__title {
    font-size: var(--text-md);
  }

  .offer__summary {
    max-width: 46ch;
  }

  .offer__facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: var(--border);
  }

  .offer__facts dt {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--label-sm);
    font-weight: 600;
    color: var(--green-600);
    margin-bottom: 0.3rem;
  }

  .offer__facts dd {
    font-size: var(--body-lg);
    font-weight: 600;
    color: var(--green-900);
    line-height: 1.3;
  }

  .offer__price {
    grid-column: 1 / -1;
  }

  .offer__price dd {
    display: grid;
    gap: 0.15rem;
    font-weight: 400;
    font-size: var(--body);
  }

  .offer__price strong {
    font-weight: 700;
    font-size: var(--body-lg);
  }

  .offer__details {
    display: grid;
    gap: var(--space-5);
    padding-top: var(--space-4);
    border-top: var(--border);
  }

  .offer__details h4 {
    margin-bottom: var(--space-2);
    font-size: var(--label);
  }

  .offer__details p,
  .offer__details li {
    font-size: var(--body-sm);
    color: var(--ink-2);
    line-height: 1.55;
  }

  .offer__details ul {
    padding-left: 1.1em;
  }

  .offer__details li + li {
    margin-top: 0.3em;
  }

  .offer__partner a {
    color: var(--green-600);
  }

  .offer__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }

  @media (min-width: 40em) {
    .offer:not(.offer--compact) .offer__facts {
      grid-template-columns: auto auto 1fr;
      gap: var(--space-7);
    }

    .offer:not(.offer--compact) .offer__price {
      grid-column: auto;
    }

    .offer__details {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
