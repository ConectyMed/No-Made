---
/**
 * Carte d'offre : pilule catégorie, durée, taille du groupe, prix, pour qui,
 * quoi apporter, bouton "Demander cette session" (design.md §6).
 * `compact` : version accueil, sans les listes détaillées.
 */
import type { CollectionEntry } from 'astro:content';
import Button from './Button.astro';
import { formatPrice } from '@/lib/format';
import { t } from '@/i18n';

interface Props {
  offer: CollectionEntry<'offers'>;
  compact?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { offer, compact = false, headingLevel: H = 'h3' } = Astro.props;
const d = offer.data;
const requestHref = `/contact/?offre=${encodeURIComponent(d.slug)}`;

/** Transforme "[NOM DU PARTENAIRE]" en marque de placeholder visible. */
const withPlaceholders = (s: string) =>
  s.split(/(\[[^\]]+\])/g).map((part) =>
    /^\[[^\]]+\]$/.test(part) ? { ph: part.slice(1, -1) } : { text: part },
  );
---

<article class:list={['offer', 'card', { 'offer--compact': compact }]} id={compact ? undefined : d.slug}>
  <header class="offer__head">
    <span class="offer__pill">{d.category}</span>
    <H class="offer__title">{d.title}</H>
    <p class="offer__summary">
      {withPlaceholders(d.summary).map((p) => ('ph' in p ? <mark class="placeholder">[{p.ph}]</mark> : p.text))}
    </p>
  </header>

  <dl class="offer__facts">
    <div>
      <dt>Durée</dt>
      <dd>{d.duration}</dd>
    </div>
    <div>
      <dt>Groupe</dt>
      <dd>{d.groupSize}</dd>
    </div>
    <div class="offer__price">
      <dt>Prix</dt>
      <dd>
        {d.pricing.map((p, i) => (
          <span class="offer__price-line">
            {i > 0 && <span class="muted"> · </span>}
            <strong>{formatPrice(p.amountCents)}</strong> <span class="muted">{p.label}</span>
          </span>
        ))}
      </dd>
    </div>
  </dl>

  {
    !compact && (
      <div class="offer__details">
        <div>
          <h4>Pour qui</h4>
          <p>{d.forWhom}</p>
        </div>
        <div>
          <h4>Au programme</h4>
          <ul>
            {d.includes.map((item) => (
              <li>{withPlaceholders(item).map((p) => ('ph' in p ? <mark class="placeholder">[{p.ph}]</mark> : p.text))}</li>
            ))}
          </ul>
        </div>
        <div>
          <h4>À prévoir</h4>
          <ul>
            {d.bring.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    )
  }

  {
    d.partnerLed && (
      <p class="offer__partner small muted">
        La séquence mobilité est encadrée par{' '}
        {withPlaceholders(d.partnerName ?? '').map((p) => ('ph' in p ? <mark class="placeholder">[{p.ph}]</mark> : p.text))}
        , éducateur diplômé. <a href="/a-propos/#partenaire">En savoir plus</a>
      </p>
    )
  }

  <footer class="offer__foot">
    <Button href={requestHref}>{t('common.requestThisSession')}</Button>
    {d.testPrice && <span class="offer__test small muted">Prix de test, susceptibles de changer.</span>}
  </footer>
</article>

<style>
  .offer {
    display: grid;
    gap: var(--space-5);
    padding: clamp(1.5rem, 1.2rem + 1.5vw, 2.25rem);
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }

  .offer:hover {
    transform: translateY(-2px);
    box-shadow: var(--card-shadow-hover);
  }

  .offer__head {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .offer__pill {
    display: inline-block;
    padding: 0.35em 0.85em;
    border-radius: var(--radius-pill);
    background: var(--bg);
    border: var(--border);
    color: var(--moss);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .offer__title {
    font-size: var(--text-2xl);
  }

  .offer__summary {
    color: var(--muted);
    max-width: 44ch;
  }

  .offer__facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: var(--border);
  }

  .offer__facts dt {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.25rem;
  }

  .offer__facts dd {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: 1.15;
  }

  .offer__price {
    grid-column: 1 / -1;
  }

  .offer__price dd {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.35rem;
  }

  .offer__price strong {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-xl);
  }

  .offer__details {
    display: grid;
    gap: var(--space-5);
    padding-top: var(--space-4);
    border-top: var(--border);
  }

  .offer__details h4 {
    margin-bottom: var(--space-2);
  }

  .offer__details p,
  .offer__details li {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .offer__details ul {
    padding-left: 1.1em;
  }

  .offer__details li + li {
    margin-top: 0.3em;
  }

  .offer__partner a {
    color: var(--moss);
  }

  .offer__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    padding-top: var(--space-2);
  }

  /* Version compacte (accueil) : les faits restent sur deux colonnes, le prix en dessous,
     une ligne par tarif. */
  .offer--compact .offer__price dd {
    display: grid;
    gap: 0.15rem;
  }

  .offer--compact .offer__price-line .muted:first-child {
    display: none; /* pas de séparateur "·" quand chaque tarif a sa ligne */
  }

  @media (min-width: 40em) {
    .offer:not(.offer--compact) .offer__facts {
      grid-template-columns: auto auto 1fr;
      gap: var(--space-6);
    }

    .offer:not(.offer--compact) .offer__price {
      grid-column: auto;
    }

    .offer__details {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .offer:hover {
      transform: none;
    }
  }
</style>
