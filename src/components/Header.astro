---
/**
 * Nav flottante en pilule (design.md §4) : point lime + nom à gauche, liens au centre sur desktop,
 * CTA vert profond à droite, précédé d'une bascule clair / sombre discrète (icône seule).
 * Mobile : nom, bascule, CTA icône, burger → panneau plein écran.
 * Le panneau est un frère de <header> pour que le backdrop-filter ne le contienne pas.
 */
import Button from './Button.astro';
import Icon from './Icon.astro';
import { site, nav, CTA_LABEL, CTA_HREF } from '@/data/site';
import { t } from '@/i18n';

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => (href.replace(/\/+$/, '') || '/') === current;
---

<header class="header glass" data-header>
  <div class="header__inner">
    <a href="/" class="brand" aria-label={t('common.home')}>
      <span class="brand__dot" aria-hidden="true"></span>
      <span class="brand__name">{site.name}</span>
    </a>

    <nav class="nav" aria-label={t('common.mainNav')}>
      <ul class="nav__list" role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="nav__link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <button
        class="theme"
        type="button"
        aria-label={t('common.themeDark')}
        data-label-dark={t('common.themeDark')}
        data-label-light={t('common.themeLight')}
        data-theme-toggle
      >
        <Icon name="moon" size={18} class="theme__moon" />
        <Icon name="sun" size={18} class="theme__sun" />
      </button>
      <Button href={CTA_HREF} variant="dark" icon="arrow-right" class="header__cta">{CTA_LABEL}</Button>
      <a href={CTA_HREF} class="header__cta-icon" aria-label={CTA_LABEL}>
        <Icon name="mail" size={20} />
      </a>
      <button
        class="burger"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t('common.openMenu')}
        data-close-label={t('common.closeMenu')}
        data-menu-toggle
      >
        <Icon name="menu" size={22} class="burger__open" />
        <Icon name="close" size={22} class="burger__close" />
      </button>
    </div>
  </div>
</header>

<div class="menu" id="mobile-menu" hidden data-menu>
  <nav class="menu__inner" aria-label={t('common.mainNav')}>
    <ul class="menu__list" role="list">
      {
        nav.map((item, i) => (
          <li style={`--i: ${i}`}>
            <a href={item.href} class="menu__link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="menu__cta" style={`--i: ${nav.length}`}>
      <Button href={CTA_HREF} variant="lime" size="lg" icon="arrow-right">{CTA_LABEL}</Button>
      <p class="small muted">{site.areaLong}</p>
    </div>
  </nav>
</div>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (header && toggle && menu) {
    const labels = { open: toggle.getAttribute('aria-label') ?? '', close: toggle.dataset.closeLabel ?? '' };
    const mq = window.matchMedia('(min-width: 56em)');
    let open = false;

    const setOpen = (next: boolean) => {
      open = next;
      menu.hidden = !next;
      toggle.setAttribute('aria-expanded', String(next));
      toggle.setAttribute('aria-label', next ? labels.close : labels.open);
      header.classList.toggle('is-open', next);
      document.documentElement.classList.toggle('menu-open', next);
      (next ? menu.querySelector<HTMLElement>('a') : toggle)?.focus({ preventScroll: true });
    };

    toggle.addEventListener('click', () => setOpen(!open));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && open && setOpen(false));
    menu.addEventListener('click', (e) => (e.target as HTMLElement).closest('a') && setOpen(false));
    mq.addEventListener('change', (e) => e.matches && open && setOpen(false));
  }

  /* ---------- Thème clair / sombre ---------- */
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (themeBtn) {
    const root = document.documentElement;
    const KEY = 'nomade-theme';
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
    const labels = { dark: themeBtn.dataset.labelDark ?? '', light: themeBtn.dataset.labelLight ?? '' };

    const apply = (theme: 'dark' | 'light') => {
      root.setAttribute('data-theme', theme);
      themeBtn.setAttribute('aria-label', theme === 'dark' ? labels.light : labels.dark);
      const color = getComputedStyle(root).getPropertyValue('--bg').trim();
      document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((m) => (m.content = color));
    };

    let saved: string | null = null;
    try {
      saved = localStorage.getItem(KEY);
    } catch {}
    apply((saved ?? (systemDark.matches ? 'dark' : 'light')) === 'dark' ? 'dark' : 'light');

    themeBtn.addEventListener('click', () => {
      const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      root.classList.add('theme-switching');
      apply(next);
      try {
        localStorage.setItem(KEY, next);
      } catch {}
      window.setTimeout(() => root.classList.remove('theme-switching'), 250);
    });

    // Sans choix explicite, on suit le système s'il change en cours de route.
    systemDark.addEventListener('change', (e) => {
      let stored: string | null = null;
      try {
        stored = localStorage.getItem(KEY);
      } catch {}
      if (!stored) apply(e.matches ? 'dark' : 'light');
    });
  }
</script>

<style>
  .header {
    position: fixed;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 60;
    width: 92%;
    max-width: var(--content-max);
    border-radius: var(--radius-pill);
    background: var(--glass-strong);
    box-shadow: var(--shadow);
  }

  .header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--header-h);
    padding: 0.5rem 0.5rem 0.5rem 1.25rem;
  }

  /* ---------- Marque ---------- */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: var(--tap-min);
    text-decoration: none;
    color: var(--green-900);
    font-size: var(--text-sm-h);
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  @media (max-width: 24em) {
    .header__inner {
      gap: var(--space-2);
      padding-left: 1rem;
    }

    .brand {
      font-size: var(--body);
    }
  }

  .brand__dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--lime);
    transition: transform var(--dur-base) ease;
  }

  .brand:hover .brand__dot {
    transform: scale(1.25);
  }

  /* ---------- Nav desktop ---------- */
  .nav {
    display: none;
    justify-self: center;
  }

  .nav__list {
    display: flex;
    gap: clamp(0.25rem, 1.2vw, 1rem);
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding: 0 0.8rem;
    border-radius: var(--radius-pill);
    color: var(--ink-2);
    font-size: var(--label);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--dur-fast) ease;
  }

  .nav__link:hover,
  .nav__link[aria-current='page'] {
    color: var(--green-900);
  }

  /* ---------- Actions ---------- */
  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    justify-self: end;
  }

  :global(.header__cta) {
    display: none !important;
  }

  /* Bascule de thème : discrète, sans fond, prend une teinte au survol. */
  .theme {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    color: var(--ink-2);
    transition:
      color var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }

  .theme:hover {
    color: var(--green-900);
    background: var(--surface-low);
  }

  .theme :global(.theme__sun),
  :global(html[data-theme='dark']) .theme :global(.theme__moon) {
    display: none;
  }

  :global(html[data-theme='dark']) .theme :global(.theme__sun) {
    display: block;
  }

  .header__cta-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--deep);
    color: var(--on-dark);
  }

  .burger {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: var(--border);
    background: var(--surface);
    color: var(--green-900);
  }

  .burger :global(.burger__close),
  .is-open .burger :global(.burger__open) {
    display: none;
  }

  .is-open .burger :global(.burger__close) {
    display: block;
  }

  /* ---------- Panneau mobile ---------- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 50;
    padding: calc(var(--header-h) + 2rem) var(--gutter) var(--space-8);
    background: var(--menu-bg);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    overflow-y: auto;
  }

  .menu__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100%;
  }

  .menu__list {
    display: grid;
    gap: var(--space-2);
  }

  .menu__list li,
  .menu__cta {
    opacity: 0;
    transform: translateY(12px);
    animation: menu-in var(--dur-slow) var(--ease-out) forwards;
    animation-delay: calc(60ms + var(--i) * 55ms);
  }

  .menu__link {
    display: block;
    padding: 0.3em 0;
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    text-decoration: none;
    color: var(--green-900);
  }

  .menu__link[aria-current='page'] {
    color: var(--green-600);
  }

  .menu__cta {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    margin-top: var(--space-8);
  }

  @keyframes menu-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  @media (min-width: 56em) {
    .nav {
      display: block;
    }

    :global(.header__cta) {
      display: inline-flex !important;
    }

    .header__cta-icon,
    .burger,
    .menu {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu__list li,
    .menu__cta {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
