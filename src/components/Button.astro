---
/**
 * Bouton ou lien-bouton, toujours en pilule (design.md §3).
 *  - lime    : accent, CTA du hero et des bandeaux
 *  - dark    : vert profond, CTA de la nav et boutons secondaires forts
 *  - glass   : blanc translucide, sur photo
 *  - outline : blanc, bordure fine
 */
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';

interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'lime' | 'dark' | 'glass' | 'outline';
  size?: 'md' | 'lg';
  icon?: IconName;
  block?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  type = 'button',
  variant = 'dark',
  size = 'md',
  icon,
  block = false,
  class: className,
  ...rest
} = Astro.props;

const classes = ['btn', `btn--${variant}`, `btn--${size}`, block && 'btn--block', className]
  .filter(Boolean)
  .join(' ');
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <span><slot /></span>
      {icon && <Icon name={icon} size={18} />}
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <span><slot /></span>
      {icon && <Icon name={icon} size={18} />}
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    min-height: var(--tap-min);
    padding: 0.7em 1.4em;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    font-size: var(--label);
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform var(--dur-fast) ease,
      background-color var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      opacity var(--dur-fast) ease;
  }

  .btn--lg {
    padding: 0.9em 1.8em;
  }

  .btn--block {
    width: 100%;
  }

  .btn--lime {
    background: var(--lime);
    color: var(--on-lime);
  }

  .btn--lime:hover {
    background: var(--lime-dim);
  }

  .btn--dark {
    background: var(--deep);
    color: var(--on-dark);
  }

  .btn--dark:hover {
    background: var(--deep-hover);
  }

  .btn--glass {
    background: var(--glass);
    color: var(--green-900);
    border-color: var(--line-strong);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .btn--glass:hover {
    background: var(--surface);
  }

  .btn--outline {
    background: var(--surface);
    color: var(--green-900);
    border-color: var(--line-strong);
  }

  .btn--outline:hover {
    border-color: var(--outline);
  }

  .btn:hover {
    transform: scale(1.02);
  }

  .btn:active {
    transform: scale(0.98);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:hover,
    .btn:active {
      transform: none;
    }
  }
</style>
