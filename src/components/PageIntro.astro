---
/** En-tête de page intérieure : étiquette en capitales, titre, chapô. L'accueil a son hero. */
import Placeholder from './Placeholder.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'start' | 'center';
}
const { eyebrow, title, lead, align = 'start' } = Astro.props;
const ph = title.match(/^\[([^\]]+)\]$/);
---

<header class:list={['intro', `intro--${align}`]}>
  <div class="container intro__inner">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{ph ? <Placeholder name={ph[1]} /> : title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .intro {
    padding-block: clamp(2rem, 1.5rem + 3vw, 4rem) clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  .intro__inner {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .intro h1 {
    font-size: var(--text-xl);
    max-width: 22ch;
  }

  .intro--center .intro__inner {
    justify-items: center;
    text-align: center;
  }
</style>
