---
/**
 * Vraie photo, optimisée par Astro (webp, plusieurs largeurs), recadrée pour remplir son cadre.
 * `caption` : une légende discrète en bas à gauche, pour dire d'où vient l'image quand ce n'est
 * pas la région (les photos de voyage d'Anthony, par exemple). Rien d'autre n'est ajouté.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  /** object-position CSS, ex. "center 40%". */
  position?: string;
  class?: string;
}

const {
  src,
  alt,
  caption,
  widths = [480, 768, 1200],
  sizes = '(min-width: 64em) 40vw, 100vw',
  loading = 'lazy',
  position = 'center',
  class: className,
} = Astro.props;
---

<figure class:list={['photo', className]}>
  <Image {src} {alt} {widths} {sizes} {loading} format="webp" quality={80} class="photo__img" style={`object-position: ${position}`} />
  {caption && <figcaption class="photo__caption">{caption}</figcaption>}
</figure>

<style>
  .photo {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    border-radius: inherit;
    overflow: hidden;
  }

  .photo :global(.photo__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo__caption {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    z-index: 2;
    padding: 0.25em 0.65em;
    border-radius: var(--radius-pill);
    background: rgba(15, 20, 17, 0.55);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
</style>
