---
/**
 * Image provisoire (visuel généré, pas une photo de sortie) : optimisée par Astro,
 * avec un badge visible "[IMAGE PROVISOIRE]" que le contrôle des placeholders détecte.
 * À remplacer par de vraies photos dès qu'elles existent.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  /** Emplacement du badge. */
  badge?: 'top-right' | 'top-left' | 'none';
}

const {
  src,
  alt,
  widths = [480, 768, 1200],
  sizes = '(min-width: 64em) 40vw, 100vw',
  loading = 'lazy',
  class: className,
  badge = 'top-right',
} = Astro.props;
---

<div class:list={['prov', className]}>
  <Image {src} {alt} {widths} {sizes} {loading} format="webp" quality={78} class="prov__img" />
  {badge !== 'none' && (
    <span class:list={['prov__badge', `prov__badge--${badge}`]} data-placeholder="IMAGE PROVISOIRE">
      [IMAGE PROVISOIRE]
    </span>
  )}
</div>

<style>
  .prov {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    overflow: hidden;
  }

  .prov :global(.prov__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .prov__badge {
    position: absolute;
    z-index: 2;
    padding: 0.3em 0.7em;
    border-radius: var(--radius-pill);
    border: 1px dashed #b8860b;
    background: rgba(255, 255, 255, 0.85);
    color: #4a4200;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .prov__badge--top-right {
    top: 0.75rem;
    right: 0.75rem;
  }

  .prov__badge--top-left {
    top: 0.75rem;
    left: 0.75rem;
  }
</style>
