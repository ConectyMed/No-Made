---
/** Sessions planifiées : à venir, passées, toutes. */
import Admin from '@/layouts/Admin.astro';
import { listOutings } from '@/lib/crm/outings';
import { OUTING_STATUS_LABEL } from '@/lib/crm/labels';
import { formatDateLong, formatTime } from '@/lib/dates';
import { formatPrice } from '@/lib/format';

export const prerender = false;

const scopeParam = Astro.url.searchParams.get('vue') ?? 'a-venir';
const scope = (['a-venir', 'passees', 'toutes'] as const).includes(scopeParam as never) ? (scopeParam as 'a-venir' | 'passees' | 'toutes') : 'a-venir';
const rows = await listOutings(scope);
const tabs = [
  { key: 'a-venir', label: 'À venir' },
  { key: 'passees', label: 'Passées' },
  { key: 'toutes', label: 'Toutes' },
];
const flash = Astro.url.searchParams.get('supprimee') ? 'Session supprimée.' : null;
---

<Admin title="Sessions">
  <div class="adm-head">
    <div>
      <span class="eyebrow">Sessions</span>
      <h1>Le planning</h1>
      <p>Les sorties datées, avec qui vient. Coche une session « faite » une fois passée : son montant compte alors dans le chiffre.</p>
    </div>
    <a href="/admin/sessions/nouvelle/" class="btn-ghost">Nouvelle session</a>
  </div>

  {flash && <p class="adm-alert adm-alert--ok" role="status">{flash}</p>}

  <nav class="tabs" aria-label="Filtrer">
    {tabs.map((t) => <a href={`/admin/sessions/?vue=${t.key}`} class="tab" aria-current={t.key === scope ? 'page' : undefined}>{t.label}</a>)}
  </nav>

  <section class="adm-card">
    {
      rows.length === 0 ? (
        <p class="adm-empty">
          {scope === 'a-venir' ? 'Rien de prévu. Crée une session, ou planifie-en une depuis une demande.' : 'Aucune session ici.'}
        </p>
      ) : (
        <table class="adm-table">
          <thead>
            <tr>
              <th>Quand</th>
              <th>Session</th>
              <th>Lieu</th>
              <th>Participants</th>
              <th>Montant</th>
              <th>Statut</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((o) => (
              <tr>
                <td>
                  <a href={`/admin/sessions/${o.id}/`}>{formatDateLong(o.startsAt)}</a>
                  <br />
                  <span class="small">{formatTime(o.startsAt)}{o.durationMin ? ` · ${Math.floor(o.durationMin / 60)}h${o.durationMin % 60 ? String(o.durationMin % 60).padStart(2, '0') : ''}` : ''}</span>
                </td>
                <td>{o.offerLabel}</td>
                <td>{o.place ?? <span class="muted">à préciser</span>}</td>
                <td>{o.people} pers.{o.participants !== o.people ? ` (${o.participants} contact${o.participants > 1 ? 's' : ''})` : ''}</td>
                <td>{formatPrice(o.amountCents)}</td>
                <td>
                  <span class:list={['badge', `badge--${o.status === 'faite' ? 'confirmee' : o.status === 'annulee' ? 'annulee' : 'nouvelle'}`]}>{OUTING_STATUS_LABEL[o.status]}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </section>
</Admin>

<style>
  .tabs { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-4); }
  .tab { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 0.9rem; border-radius: var(--radius-pill); border: var(--border); background: var(--surface); color: var(--ink-2); font-size: var(--label-sm); font-weight: 600; text-decoration: none; }
  .tab[aria-current='page'] { background: var(--green-900); color: var(--bg); border-color: transparent; }
  @media (max-width: 48em) {
    .adm-table thead { display: none; }
    .adm-table tr { display: grid; gap: 0.25rem; padding: var(--space-3) 0; border-bottom: var(--border); }
    .adm-table td { padding: 0; border: 0; }
  }
</style>
