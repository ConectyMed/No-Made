---
/** Articles de « Ma philosophie » : brouillons et publiés. */
import Admin from '@/layouts/Admin.astro';
import { listArticles } from '@/lib/crm/articles';
import { formatDate, formatRelative } from '@/lib/dates';

export const prerender = false;

const rows = await listArticles();
const flash = Astro.url.searchParams.get('supprime') ? 'Article supprimé.' : null;
---

<Admin title="Articles">
  <div class="adm-head">
    <div>
      <span class="eyebrow">Ma philosophie</span>
      <h1>Les articles</h1>
      <p>Ce que tu écris ici paraît sur la page <a href="/philosophie/">Ma philosophie</a> dès que tu le publies. Un brouillon reste invisible.</p>
    </div>
    <a href="/admin/articles/nouveau" class="btn-ghost">Nouvel article</a>
  </div>

  {flash && <p class="adm-alert adm-alert--ok" role="status">{flash}</p>}

  <section class="adm-card">
    {
      rows.length === 0 ? (
        <p class="adm-empty">Aucun article pour l’instant. <a href="/admin/articles/nouveau">Écris le premier</a>.</p>
      ) : (
        <table class="adm-table">
          <thead>
            <tr>
              <th>Titre</th>
              <th>Statut</th>
              <th>Publié le</th>
              <th>Modifié</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((a) => (
              <tr>
                <td>
                  <a href={`/admin/articles/${a.id}`}>{a.title}</a>
                </td>
                <td>
                  <span class:list={['badge', a.status === 'publie' ? 'badge--confirmee' : 'badge--nouvelle']}>{a.status === 'publie' ? 'Publié' : 'Brouillon'}</span>
                </td>
                <td>{a.publishedAt ? formatDate(a.publishedAt) : <span class="muted">—</span>}</td>
                <td class="small">{formatRelative(a.updatedAt)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </section>
</Admin>

<style>
  .adm-head p a,
  .adm-empty a {
    color: var(--green-600);
    font-weight: 600;
  }
  @media (max-width: 48em) {
    .adm-table thead { display: none; }
    .adm-table tr { display: grid; gap: 0.25rem; padding: var(--space-3) 0; border-bottom: var(--border); }
    .adm-table td { padding: 0; border: 0; }
  }
</style>
