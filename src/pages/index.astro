---
/**
 * Accueil (design.md v2 §6) : hero, pourquoi sortir, trois temps forts, Reconnexion, déroulement,
 * prix, formulaire. Le site parle en « je » : la personne qui encadre. Vraies photos d'Anthony (celles du Pérou
 * sont légendées) ; le seul visuel encore provisoire (« Bouger ») reste étiqueté.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import type { IconName } from '@/components/Icon.astro';
import type { ImageMetadata } from 'astro';
import ProvisionalImage from '@/components/ProvisionalImage.astro';
import Photo from '@/components/Photo.astro';
import HeroVideo from '@/components/HeroVideo.astro';
import ContactForm from '@/components/ContactForm.astro';
import Quote from '@/components/Quote.astro';
import Placeholder from '@/components/Placeholder.astro';
import { usePage, t } from '@/i18n';
import { site, CTA_LABEL, CTA_HREF, VISIO_LABEL, VISIO_HREF } from '@/data/site';
import { formatPrice } from '@/lib/format';

import marcheImg from '@/assets/photos/escalier-perou.jpg';
import mobiliteImg from '@/assets/provisoire/mobilite.png';
import respirationImg from '@/assets/photos/rochers-coucher-soleil.jpg';
import reconnexImg from '@/assets/photos/lac-perou.jpg';

const page = usePage('home');
const h1Lines = page.h1.split('\n');

const offers = (await getCollection('offers', ({ filePath }) => filePath?.includes('/offers/fr/'))).sort(
  (a, b) => a.data.order - b.data.order,
);
const entry = offers[0]; // Expérience corps / aventure, 2h30
const groupPrice = entry?.data.pricing.find((p) => p.amountCents !== undefined);
const soloPrice = entry?.data.pricing.find((p) => p.amountCents === undefined);
const reconnex = offers.find((o) => o.data.slug === 'reconnexion-parent-enfant');
const duoPrice = reconnex?.data.pricing[0];

// Bandeau de repères du hero : uniquement des données du site (durées des offres, visio), rien d'inventé.
const facts: { value: string; label: string; accent?: boolean }[] = [
  { value: entry?.data.duration ?? '2h30', label: 'Session corps / aventure, en solo ou en groupe' },
  { value: reconnex?.data.duration ?? '3h', label: 'Reconnexion parent / enfant' },
  { value: site.visio.duration.replace('minutes', 'min'), label: 'En visio, gratuites, avant de réserver' },
  { value: '0 écran', label: 'Le téléphone reste dans le sac', accent: true },
];

// Cartes flottantes du hero : les trois temps d'une session, vignettes = vraies photos (détail dans #temps-forts).
const heroCards: { title: string; text: string; img: ImageMetadata; position: string }[] = [
  { title: 'Marcher', text: 'Sentiers de la région, rythme adapté', img: marcheImg, position: 'center 30%' },
  { title: 'Bouger', text: 'Poids du corps, mobilité', img: respirationImg, position: 'center 35%' },
  { title: 'Respirer', text: 'Souffle, concentration, sans écran', img: reconnexImg, position: 'center 55%' },
];

// Les quatre raisons de sortir, telles que formulées par la personne qui encadre.
const pillars: { icon: IconName; title: string; text: string; foot: string }[] = [
  {
    icon: 'hands',
    title: 'Un corps qui suit',
    text: 'Retrouver une bonne condition physique sans salle ni machine : la marche, le poids du corps, des mouvements qui servent tous les jours.',
    foot: '01 / Condition',
  },
  {
    icon: 'walk',
    title: 'Sortir de la routine',
    text: 'Casser le rythme habituel, changer de décor, faire ce qu’on ne fait jamais. La zone de confort, on en sort à pied.',
    foot: '02 / Routine',
  },
  {
    icon: 'wind',
    title: 'Une tête plus claire',
    text: 'Respirer, se concentrer, laisser le bruit derrière. Entretenir ce qui nous sert toute la vie : le souffle, l’attention.',
    foot: '03 / Esprit',
  },
  {
    icon: 'leaf',
    title: 'Redécouvrir ce qui t’entoure',
    text: 'Les sentiers, la garrigue, les collines à vingt minutes de chez toi. On les regarde rarement. On va les parcourir.',
    foot: '04 / Nature',
  },
];
---

<Base title={page.title} description={page.description} isHome bodyClass="page-home">
  <!-- 1. Hero : cadre clair, texte à gauche, vidéo qui déborde à droite, cartes flottantes, repères en bas -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <div class="hero__frame frame">
        <div class="hero__media">
          <HeroVideo
            poster="/hero/hero-poster.webp"
            posterSmall="/hero/hero-poster-640.webp"
            posterBlur="/hero/hero-poster-blur.webp"
            srcDesktop="/hero/hero-720.mp4"
            srcMobile="/hero/hero-540.mp4"
            alt="Un sentier vide dans la garrigue au lever du jour, pins parasols et collines dans la brume, région PACA"
          />
          <div class="hero__shade" aria-hidden="true"></div>
        </div>

        <div class="hero__content">
          <span class="hero__tag">
            <Icon name="leaf" size={14} />
            {page.tag}
          </span>

          <h1 id="hero-title" class="hero__title">
            {h1Lines.map((line, i) => (
              <>
                {i === h1Lines.length - 1 ? <span class="hero__accent">{line}</span> : line}
                {i < h1Lines.length - 1 && <br />}
              </>
            ))}
          </h1>
          <p class="hero__lead">{page.lead}</p>

          <div class="hero__cta">
            <Button href={CTA_HREF} variant="lime" size="lg" icon="arrow-right">{CTA_LABEL}</Button>
            <Button href="#approche" variant="outline" size="lg" icon="chevron-down">{t('common.discover')}</Button>
          </div>

          <p class="hero__note small muted">
            <Icon name="video" size={16} class="hero__note-icon" />
            <span>
              Tu préfères en parler d’abord ? <a href={VISIO_HREF}>{site.visio.duration} en visio</a>, gratuites et sans engagement.
            </span>
          </p>
        </div>

        <ul class="hero__cards" role="list" aria-label="Les trois temps d’une session">
          {heroCards.map((c, i) => (
            <li class="hero__card glass" style={`--i: ${i}`}>
              <a href="#temps-forts" class="hero__card-link">
                <Image src={c.img} width={112} height={112} format="webp" quality={75} alt="" class="hero__card-img" style={`object-position: ${c.position}`} />
                <span class="hero__card-text">
                  <strong>{c.title}</strong>
                  <span class="small muted">{c.text}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>

        <ul class="hero__facts" role="list" aria-label="Repères">
          {facts.map((f) => (
            <li class:list={['hero__fact', 'glass', { 'hero__fact--accent': f.accent }]}>
              <strong class="hero__fact-value">{f.value}</strong>
              <span class="hero__fact-label small muted">{f.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 2. Pourquoi sortir -->
  <section class="section" id="approche" aria-labelledby="approche-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Pourquoi sortir</span>
        <h2 id="approche-title">Ce que je te propose de retrouver dehors.</h2>
      </div>
      <ul class="pillars" role="list">
        {pillars.map((p, i) => (
          <li class="pillar card card--hover" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <div>
              <span class="pillar__icon"><Icon name={p.icon} size={24} /></span>
              <h3 class="pillar__title">{p.title}</h3>
              <p class="pillar__text small muted">{p.text}</p>
            </div>
            <span class="pillar__foot label-sm">{p.foot}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. Trois temps forts -->
  <section class="section" id="temps-forts" aria-labelledby="temps-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Une expérience corps / aventure</span>
        <h2 id="temps-title">Ce qu’on fait pendant une session</h2>
        <p class="lead">Trois temps, dans des proportions qui dépendent de toi. Je m’adapte à ton profil, en solo comme en groupe.</p>
      </div>
      <div class="moments">
        <article class="moment card card--hover" data-reveal>
          <div class="moment__media">
            <Photo src={marcheImg} alt="Vu d’en haut, un escalier de pierre qui descend à pic dans la montagne, au-dessus d’une vallée dans les nuages" caption="Pérou" position="center 30%" />
            <span class="moment__pill glass label-sm">Temps 01</span>
          </div>
          <div class="moment__body">
            <div>
              <h3>Marcher, randonner</h3>
              <p class="muted">On part d’un point de rendez-vous et on marche, parfois on grimpe un peu. Le terrain fait le travail, le rythme s’adapte à toi ou au groupe.</p>
            </div>
            <div class="moment__foot small muted">
              <span>Sentiers de la région · rythme adapté</span>
              <Icon name="walk" size={20} class="moment__icon" />
            </div>
          </div>
        </article>

        <article class="moment card card--hover" data-reveal style="--reveal-delay: 80ms">
          <div class="moment__media">
            <ProvisionalImage src={mobiliteImg} alt="Une personne qui fait un exercice de mobilité en plein air" />
            <span class="moment__pill glass label-sm">Temps 02</span>
          </div>
          <div class="moment__body">
            <div>
              <h3>Bouger</h3>
              <p class="muted">Préparation physique fonctionnelle au poids du corps, et mobilité inspirée du yoga et du mouvement animal. Des gestes simples, progressifs, adaptés à chacun.</p>
            </div>
            <div class="moment__foot small muted">
              <span>Poids du corps · mobilité</span>
              <Icon name="hands" size={20} class="moment__icon" />
            </div>
          </div>
        </article>

        <article class="moment card card--hover" data-reveal style="--reveal-delay: 160ms">
          <div class="moment__media">
            <Photo src={respirationImg} alt="Une personne accroupie sur les rochers, face à la mer, au coucher du soleil" position="center 35%" />
            <span class="moment__pill glass label-sm">Temps 03</span>
          </div>
          <div class="moment__body">
            <div>
              <h3>Respirer, se concentrer</h3>
              <p class="muted">On finit posé : des techniques de respiration et de concentration, puis un temps pour parler de ce qu’on a vécu, sans téléphone. Souvent le moment qu’on retient.</p>
            </div>
            <div class="moment__foot small muted">
              <span>Fin de session · sans écran</span>
              <Icon name="wind" size={20} class="moment__icon" />
            </div>
          </div>
        </article>
      </div>
      <Quote
        text="Toutes les grandes personnes ont d’abord été des enfants. (Mais peu d’entre elles s’en souviennent.)"
        by="Antoine de Saint-Exupéry"
        source="Le Petit Prince, 1943"
        class="quote-after"
      />
    </div>
  </section>

  <!-- 4. Reconnexion -->
  <section class="section" id="reconnex" aria-labelledby="reconnex-title">
    <div class="container">
      <div class="reconnex frame" data-reveal>
        <div class="reconnex__visual">
          <div class="reconnex__media">
            <div class="reconnex__img frame">
              <Photo src={reconnexImg} alt="Un lac d’altitude immobile où se reflètent les glaciers" caption="Pérou" sizes="(min-width: 64em) 45vw, 100vw" position="center 55%" />
            </div>
            <span class="reconnex__badge glass label-sm">
              <Icon name="phone-off" size={18} class="reconnex__badge-icon" />
              Sans écran
            </span>
          </div>
          <Quote who="karim-b" compact class="reconnex__quote" />
        </div>
        <div class="reconnex__text">
          <span class="reconnex__label eyebrow">Format parent / enfant</span>
          <h2 id="reconnex-title">Reconnexion : une demi-journée parent / enfant, sans écran</h2>
          <p class="lead">Trois heures dehors, à deux. On marche, on bouge ensemble, et on prend le temps de parler.</p>
          <ul class="checks" role="list">
            <li><span class="checks__dot"><Icon name="check" size={14} /></span><span><strong>Sans pression :</strong> des exercices simples, à ton rythme et au sien.</span></li>
            <li><span class="checks__dot"><Icon name="check" size={14} /></span><span><strong>Téléphones dans le sac :</strong> l’attention va à l’autre et au sentier.</span></li>
            <li><span class="checks__dot"><Icon name="check" size={14} /></span><span><strong>Un vrai temps à deux :</strong> loin de la maison, loin des écrans.</span></li>
          </ul>
          <div class="reconnex__cta">
            <Button href={`/contact/?offre=${reconnex?.data.slug ?? ''}#demande`} variant="dark" icon="arrow-right">Demander une session Reconnexion</Button>
            {duoPrice?.amountCents !== undefined && (
              <span class="label-sm muted">{formatPrice(duoPrice.amountCents)} {duoPrice.label} · prix de test</span>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Déroulement -->
  <section class="section" id="deroulement" aria-labelledby="deroulement-title">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <span class="eyebrow">Déroulement</span>
        <h2 id="deroulement-title">Trois étapes, pas plus</h2>
      </div>
      <ol class="steps" role="list">
        {[
          { t: 'Tu m’écris', d: 'Le formulaire ci-dessous : la session qui t’intéresse, seul ou à plusieurs, tes disponibilités. Ou un créneau visio, si tu préfères en parler d’abord.' },
          { t: 'On cale une date', d: 'Je te réponds par email. On regarde ensemble le lieu, l’heure et ce qu’il faut prévoir.' },
          { t: 'On se retrouve dehors', d: 'Chaussures fermées, de l’eau dans le sac. Le téléphone reste dedans, le reste suit.' },
        ].map((s, i) => (
          <li class="step card" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.t}</h3>
            <p class="muted">{s.d}</p>
          </li>
        ))}
      </ol>
      <Quote who="lea-d" class="quote-after quote-center" />
    </div>
  </section>

  <!-- 6. Prix -->
  {entry && groupPrice && groupPrice.amountCents !== undefined && (
    <section class="section section--tight" id="prix" aria-labelledby="prix-title">
      <div class="container">
        <div class="price frame" data-reveal>
          <div class="price__glow" aria-hidden="true"></div>
          <div class="price__grid">
            <div class="price__text">
              <span class="price__pill label-sm">Prix de test</span>
              <h3 id="prix-title" class="price__title">{entry.data.title} : {entry.data.duration}, en solo ou en petit groupe</h3>
              <p class="price__desc">{entry.data.summary}</p>
              <a href={VISIO_HREF} class="price__link label-sm">{VISIO_LABEL} avant de te décider</a>
            </div>
            <div class="price__side">
              <div class="price__amount">
                <span class="label-sm price__amount-label">En groupe de 3 à 5</span>
                <div>
                  <strong>{formatPrice(groupPrice.amountCents)}</strong>
                  <span class="price__per">/ {groupPrice.label.replace(/^par /, '').replace(/, en groupe$/, '')}</span>
                </div>
                {soloPrice && (
                  <span class="price__solo small">
                    En solo : <Placeholder name={soloPrice.placeholder ?? 'TARIF SOLO'} />
                  </span>
                )}
              </div>
              <Button href={`/contact/?offre=${entry.data.slug}#demande`} variant="lime" size="lg" icon="arrow-right">Demander cette session</Button>
              <a href="/offres/" class="price__link label-sm">Voir les deux sessions</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 7. Contact -->
  <section class="section" id="contact" aria-labelledby="contact-title">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <span class="eyebrow">Prends contact</span>
        <h2 id="contact-title">Envie de sortir ? Écris-moi.</h2>
        <p class="lead">Dis-moi quelle session t’intéresse, seul ou à plusieurs, et quand. Je te réponds par email. Tu préfères en parler d’abord ? <a href={VISIO_HREF}>Réserve un créneau visio</a>, c’est gratuit.</p>
      </div>
      <div class="contact__form" data-reveal>
        <ContactForm />
      </div>
    </div>
  </section>

</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    --hero-pad: clamp(1.25rem, 0.75rem + 2.5vw, 3.5rem);
    padding-bottom: var(--space-6);
  }

  /* Mobile : une colonne (texte, média, cartes, repères). Desktop : grille 2 colonnes + rangée de repères. */
  .hero__frame {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: var(--border);
    box-shadow: var(--shadow);
    isolation: isolate;
  }

  .hero__media {
    position: relative;
    order: 2;
    width: 100%;
    aspect-ratio: 4 / 3;
    isolation: isolate;
    animation: hero-media 1.4s ease-out both;
  }

  /* Le média fond dans la surface du cadre : par le bas sur mobile, par la gauche et le bas sur desktop. */
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(to top, var(--surface) 0%, transparent 45%);
  }

  /* Bouton pause de la vidéo : en haut à droite, hors des cartes et des repères. */
  .hero__media :global(.hv__toggle) {
    top: 1rem;
    right: 1rem;
    bottom: auto;
    z-index: 3;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    order: 1;
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding: var(--hero-pad) var(--hero-pad) var(--space-4);
  }

  .hero__content > * {
    animation: hero-rise 0.9s var(--ease-out) both;
  }

  .hero__content > :nth-child(2) { animation-delay: 80ms; }
  .hero__content > :nth-child(3) { animation-delay: 160ms; }
  .hero__content > :nth-child(4) { animation-delay: 240ms; }
  .hero__content > :nth-child(5) { animation-delay: 320ms; }

  .hero__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    background: var(--lime-soft);
    color: var(--green-600);
    font-size: var(--label-upper);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__title {
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4.25rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--green-900);
  }

  .hero__accent {
    color: var(--green-600);
  }

  .hero__lead {
    font-size: var(--body-lg);
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 34rem;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .hero__note {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    max-width: 30rem;
  }

  .hero__note :global(.hero__note-icon) {
    flex: none;
    margin-top: 0.15rem;
    color: var(--green-600);
  }

  .hero__note a {
    color: var(--green-600);
    font-weight: 600;
  }

  /* Cartes : les trois temps d'une session. Sur mobile elles remontent sur le bas du média. */
  .hero__cards {
    position: relative;
    z-index: 2;
    order: 3;
    display: grid;
    gap: var(--space-3);
    margin: -3rem var(--hero-pad) 0;
  }

  .hero__card {
    border-radius: var(--radius-box);
    box-shadow: var(--shadow);
    animation: hero-rise 0.9s var(--ease-out) both;
    animation-delay: calc(360ms + var(--i, 0) * 90ms);
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }

  .hero__card:hover {
    box-shadow: var(--shadow-hover);
  }

  .hero__card-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.6rem 1rem 0.6rem 0.6rem;
    color: inherit;
    text-decoration: none;
  }

  .hero__card :global(.hero__card-img) {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 0.65rem;
    object-fit: cover;
  }

  .hero__card-text {
    display: grid;
    gap: 0.1rem;
  }

  .hero__card-text strong {
    font-size: var(--label);
    font-weight: 700;
    color: var(--green-900);
  }

  /* Repères : durées et conditions réelles, jamais des chiffres inventés. */
  .hero__facts {
    position: relative;
    z-index: 2;
    order: 4;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    padding: var(--space-5) var(--hero-pad) var(--hero-pad);
  }

  .hero__fact {
    display: grid;
    gap: 0.2rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-box);
  }

  .hero__fact--accent {
    background: var(--lime-soft);
    border-color: var(--lime);
  }

  .hero__fact-value {
    font-size: var(--text-md);
    font-weight: 700;
    line-height: 1.1;
    color: var(--green-900);
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-media {
    from {
      opacity: 0.4;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__content > *,
    .hero__card,
    .hero__media {
      animation: none;
    }
  }

  /* Tablette : média moins haut, les trois cartes sur une ligne. */
  @media (min-width: 40em) and (max-width: 63.98em) {
    .hero__media {
      aspect-ratio: 16 / 9;
    }

    .hero__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: -2.5rem;
    }
  }

  @media (min-width: 64em) {
    .hero__frame {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-rows: minmax(0, 1fr) auto;
      min-height: min(84svh, 720px);
    }

    /* Le média couvre la moitié droite du cadre, sur toute la hauteur, derrière les cartes et les repères. */
    .hero__media {
      position: absolute;
