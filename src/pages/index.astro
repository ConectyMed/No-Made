---
/**
 * Accueil (design.md v2 §6) : hero, l'approche, trois temps forts, Reconnexion, déroulement,
 * prix, formulaire. Les images sont provisoires et étiquetées ; la vidéo remplacera l'image du hero (M1).
 */
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import type { IconName } from '@/components/Icon.astro';
import ProvisionalImage from '@/components/ProvisionalImage.astro';
import HeroVideo from '@/components/HeroVideo.astro';
import ContactForm from '@/components/ContactForm.astro';
import Placeholder from '@/components/Placeholder.astro';
import { usePage } from '@/i18n';
import { site, CTA_LABEL, CTA_HREF } from '@/data/site';
import { formatPrice } from '@/lib/format';

import marcheImg from '@/assets/provisoire/groupe-marche.png';
import mobiliteImg from '@/assets/provisoire/mobilite.png';
import respirationImg from '@/assets/provisoire/respiration.png';
import reconnexImg from '@/assets/provisoire/parent-ado.png';

const page = usePage('home');
const h1Lines = page.h1.split('\n');

const offers = (await getCollection('offers', ({ filePath }) => filePath?.includes('/offers/fr/'))).sort(
  (a, b) => a.data.order - b.data.order,
);
const entry = offers[0]; // Reconnexion nature, 2h30
const halfDay = offers.find((o) => o.data.slug === 'demi-journee-hors-ecran');
const duoPrice = halfDay?.data.pricing[0];

const specs: { icon: IconName; text: string }[] = [
  { icon: 'pin', text: `Région ${site.area}` },
  { icon: 'users', text: '3 à 5 personnes' },
  { icon: 'leaf', text: '100 % dehors' },
];

const pillars: { icon: IconName; title: string; text: string; foot: string }[] = [
  {
    icon: 'leaf',
    title: 'Dehors, sur de vrais sentiers',
    text: 'Des chemins de la région PACA, choisis selon la saison et le groupe. Loin du bruit, sans aller loin.',
    foot: '01 / Terrain',
  },
  {
    icon: 'walk',
    title: 'Marcher, sans chrono',
    text: 'Un rythme tranquille et des pauses pour regarder. Pas de kilomètres à faire, pas de performance.',
    foot: '02 / Marche',
  },
  {
    icon: 'hands',
    title: 'Faire ensemble',
    text: 'Quelques exercices simples à faire à plusieurs, sans compétition. Juste de quoi se parler autrement.',
    foot: '03 / Coopération',
  },
  {
    icon: 'chat',
    title: 'Petit groupe',
    text: 'Trois à cinq personnes, pour que chacun ait la place de parler et d’écouter.',
    foot: '04 / Groupe',
  },
];
---

<Base title={page.title} description={page.description} isHome bodyClass="page-home">
  <!-- 1. Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <div class="hero__frame frame">
        <div class="hero__media">
          <HeroVideo
            poster="/hero/hero-poster.webp"
            posterSmall="/hero/hero-poster-640.webp"
            posterBlur="/hero/hero-poster-blur.webp"
            srcDesktop="/hero/hero-720.mp4"
            srcMobile="/hero/hero-540.mp4"
            alt="Un sentier vide dans la garrigue au lever du jour, pins parasols et collines dans la brume, région PACA"
          />
        </div>
        <div class="hero__shade" aria-hidden="true"></div>

        <div class="hero__content">
          <span class="hero__tag glass">
            <span class="hero__tag-dot" aria-hidden="true"></span>
            {page.tag}
          </span>

          <h1 id="hero-title" class="hero__title">
            {h1Lines.map((line, i) => (
              <>
                {line}
                {i < h1Lines.length - 1 && <br />}
              </>
            ))}
          </h1>
          <p class="hero__lead">{page.lead}</p>

          <div class="hero__cta">
            <Button href={CTA_HREF} variant="lime" size="lg" icon="arrow-right">{CTA_LABEL}</Button>
            <Button href="#approche" variant="glass" size="lg" icon="chevron-down">Découvrir le format</Button>
          </div>

          <ul class="specs glass" role="list">
            {specs.map((s) => (
              <li>
                <Icon name={s.icon} size={18} class="specs__icon" />
                <span>{s.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. L'approche -->
  <section class="section" id="approche" aria-labelledby="approche-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">L’approche Nó Made</span>
        <h2 id="approche-title">Une sortie simple, dehors, en petit groupe.</h2>
      </div>
      <ul class="pillars" role="list">
        {pillars.map((p, i) => (
          <li class="pillar card card--hover" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <div>
              <span class="pillar__icon"><Icon name={p.icon} size={24} /></span>
              <h3 class="pillar__title">{p.title}</h3>
              <p class="pillar__text small muted">{p.text}</p>
            </div>
            <span class="pillar__foot label-sm">{p.foot}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. Trois temps forts -->
  <section class="section" id="temps-forts" aria-labelledby="temps-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Trois temps forts</span>
        <h2 id="temps-title">Ce qu’on fait pendant une session</h2>
      </div>
      <div class="moments">
        <article class="moment card card--hover" data-reveal>
          <div class="moment__media">
            <ProvisionalImage src={marcheImg} alt="Un petit groupe qui marche sur un sentier, vu de dos" />
            <span class="moment__pill glass label-sm">Temps 01</span>
          </div>
          <div class="moment__body">
            <div>
              <h3>Marcher</h3>
              <p class="muted">On part d’un point de rendez-vous et on marche à un rythme tranquille. On s’arrête quand un endroit le mérite. Pas de montre, pas d’objectif.</p>
            </div>
            <div class="moment__foot small muted">
              <span>Rythme tranquille · sentiers de la région</span>
              <Icon name="walk" size={20} class="moment__icon" />
            </div>
          </div>
        </article>

        <article class="moment card card--hover" data-reveal style="--reveal-delay: 80ms">
          <div class="moment__media">
            <ProvisionalImage src={mobiliteImg} alt="Une personne qui fait un exercice de mobilité en plein air" />
            <span class="moment__pill glass label-sm">Temps 02</span>
          </div>
          <div class="moment__body">
            <div>
              <h3>Bouger, avec <Placeholder name="NOM DU PARTENAIRE" /></h3>
              <p class="muted">Dans la demi-journée, une séquence de mobilité douce encadrée par <Placeholder name="NOM DU PARTENAIRE" />, éducateur diplômé. Adaptée à chacun, sans forcer.</p>
            </div>
            <div class="moment__foot small muted">
              <span>Uniquement dans la demi-journée</span>
              <Icon name="hands" size={20} class="moment__icon" />
            </div>
          </div>
        </article>

        <article class="moment card card--hover" data-reveal style="--reveal-delay: 160ms">
          <div class="moment__media">
            <ProvisionalImage src={respirationImg} alt="Une personne qui respire calmement face aux collines" />
            <span class="moment__pill glass label-sm">Temps 03</span>
          </div>
          <div class="moment__body">
            <div>
              <h3>Respirer et parler</h3>
              <p class="muted">On finit par un temps posé : on respire, on parle de ce qu’on a vécu, sans téléphone. C’est souvent le moment qu’on retient.</p>
            </div>
            <div class="moment__foot small muted">
              <span>Fin de session · en petit groupe</span>
              <Icon name="chat" size={20} class="moment__icon" />
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. Reconnexion -->
  <section class="section" id="reconnex" aria-labelledby="reconnex-title">
    <div class="container">
      <div class="reconnex frame" data-reveal>
        <div class="reconnex__visual">
          <div class="reconnex__img frame">
            <ProvisionalImage src={reconnexImg} alt="Un parent et un adolescent assis côte à côte en pleine nature" sizes="(min-width: 64em) 45vw, 100vw" />
          </div>
          <span class="reconnex__badge glass label-sm">
            <Icon name="phone-off" size={18} class="reconnex__badge-icon" />
            Sans écran
          </span>
        </div>
        <div class="reconnex__text">
          <span class="reconnex__label eyebrow">Format parent / ado</span>
          <h2 id="reconnex-title">Reconnexion : une demi-journée parent / ado, sans écran</h2>
          <p class="lead">Trois heures dehors, à deux. On marche, on fait quelques exercices ensemble, et on prend le temps de parler.</p>
          <ul class="checks" role="list">
            <li><span class="checks__dot"><Icon name="check" size={14} /></span><span><strong>Sans pression :</strong> des exercices simples, à ton rythme et au sien.</span></li>
            <li><span class="checks__dot"><Icon name="check" size={14} /></span><span><strong>Téléphones dans le sac :</strong> l’attention va à l’autre et au sentier.</span></li>
            <li><span class="checks__dot"><Icon name="check" size={14} /></span><span><strong>Un vrai temps à deux :</strong> loin de la maison, loin des écrans.</span></li>
          </ul>
          <div class="reconnex__cta">
            <Button href={`/contact/?offre=${halfDay?.data.slug ?? ''}#demande`} variant="dark" icon="arrow-right">Demander une session Reconnexion</Button>
            {duoPrice && (
              <span class="label-sm muted">{formatPrice(duoPrice.amountCents)} {duoPrice.label} · prix de test</span>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Déroulement -->
  <section class="section" id="deroulement" aria-labelledby="deroulement-title">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <span class="eyebrow">Déroulement</span>
        <h2 id="deroulement-title">Trois étapes, pas plus</h2>
      </div>
      <ol class="steps" role="list">
        {[
          { t: 'Tu nous écris', d: 'Le formulaire ci-dessous : la session qui t’intéresse, le nombre de personnes, tes disponibilités.' },
          { t: 'On cale une date', d: 'On te répond par email. On regarde ensemble le lieu, l’heure et ce qu’il faut prévoir.' },
          { t: 'On se retrouve dehors', d: 'Chaussures fermées, de l’eau dans le sac. Le téléphone reste dedans, le reste suit.' },
        ].map((s, i) => (
          <li class="step card" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.t}</h3>
            <p class="muted">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 6. Prix -->
  {entry && (
    <section class="section section--tight" id="prix" aria-labelledby="prix-title">
      <div class="container">
        <div class="price frame" data-reveal>
          <div class="price__glow" aria-hidden="true"></div>
          <div class="price__grid">
            <div class="price__text">
              <span class="price__pill label-sm">Prix de test</span>
              <h3 id="prix-title" class="price__title">{entry.data.title} : {entry.data.duration} en petit groupe</h3>
              <p class="price__desc">{entry.data.summary}</p>
            </div>
            <div class="price__side">
              <div class="price__amount">
                <span class="label-sm price__amount-label">{entry.data.groupSize}</span>
                <div>
                  <strong>{formatPrice(entry.data.pricing[0].amountCents)}</strong>
                  <span class="price__per">/ {entry.data.pricing[0].label.replace(/^par /, '')}</span>
                </div>
              </div>
              <Button href={`/contact/?offre=${entry.data.slug}#demande`} variant="lime" size="lg" icon="arrow-right">Demander cette session</Button>
              <a href="/offres/" class="price__link label-sm">Voir les deux offres</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 7. Contact -->
  <section class="section" id="contact" aria-labelledby="contact-title">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <span class="eyebrow">Prends contact</span>
        <h2 id="contact-title">Envie de sortir ? Écris-nous.</h2>
        <p class="lead">Dis-nous quelle session t’intéresse, pour combien de personnes et quand. On te répond par email.</p>
      </div>
      <div class="contact__form" data-reveal>
        <ContactForm />
      </div>
    </div>
  </section>

  {site.showTestimonials && <section class="section" aria-label="Témoignages" />}
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding-bottom: var(--space-6);
  }

  .hero__frame {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: min(85svh, 660px);
    padding: clamp(1.5rem, 1rem + 3vw, 4rem);
    border: var(--border);
    box-shadow: var(--shadow);
    isolation: isolate;
  }

  @media (max-width: 40em) {
    .hero__frame {
      min-height: 580px;
    }
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(to top, rgba(8, 32, 19, 0.9) 0%, rgba(8, 32, 19, 0.5) 45%, transparent 100%);
  }

  /* Le bouton pause de la vidéo doit rester cliquable au-dessus du voile. */
  .hero__media :global(.hv__toggle) {
    z-index: 3;
  }

  .hero__media {
    z-index: 0;
  }

  /* Entrée (accueil uniquement, design.md §9) : le contenu monte en fondu, le média se révèle. */
  .hero__content > * {
    animation: hero-rise 0.9s var(--ease-out) both;
  }

  .hero__content > :nth-child(2) { animation-delay: 80ms; }
  .hero__content > :nth-child(3) { animation-delay: 160ms; }
  .hero__content > :nth-child(4) { animation-delay: 240ms; }
  .hero__content > :nth-child(5) { animation-delay: 320ms; }

  .hero__media {
    animation: hero-media 1.4s ease-out both;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-media {
    from {
      opacity: 0.4;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__content > *,
    .hero__media {
      animation: none;
    }
  }

  .hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: 48rem;
    color: var(--on-dark);
  }

  .hero__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-pill);
    color: var(--green-900);
    font-size: var(--label-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    margin-bottom: var(--space-2);
  }

  .hero__tag-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--lime);
  }

  .hero__title {
    color: var(--on-dark);
    max-width: 18ch;
  }

  .hero__lead {
    font-size: var(--body-lg);
    line-height: 1.55;
    color: var(--on-dark-muted);
    max-width: 40rem;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block: var(--space-2) var(--space-5);
  }

  .specs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.25rem;
    padding: 0.75rem 1.25rem;
    border-radius: 1rem;
    color: var(--green-900);
    font-size: var(--label-sm);
    font-weight: 600;
  }

  .specs li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .specs li + li {
    position: relative;
  }

  .specs :global(.specs__icon) {
    color: var(--green-600);
  }

  /* ---------- Piliers ---------- */
  .pillars {
    display: grid;
    gap: var(--space-5);
  }

  .pillar {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-6);
  }

  .pillar__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--space-5);
    border-radius: var(--radius-box);
    background: var(--surface-low);
    color: var(--green-900);
  }

  .pillar__title {
    font-size: var(--text-sm-h);
    margin-bottom: var(--space-2);
  }

  .pillar__foot {
    padding-top: var(--space-4);
    border-top: 1px solid rgba(194, 200, 193, 0.3);
    color: var(--green-600);
  }

  /* ---------- Temps forts ---------- */
  .moments {
    display: grid;
    gap: var(--space-6);
  }

  .moment {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .moment__media {
    position: relative;
    height: 16rem;
    border-radius: 0;
  }

  .moment__media :global(.prov) {
    border-radius: 0;
  }

  .moment__pill {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-pill);
    color: var(--green-900);
    font-weight: 500;
  }

  .moment__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
    padding: var(--space-6);
  }

  .moment__body h3 {
    margin-bottom: var(--space-3);
  }

  .moment__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid rgba(194, 200, 193, 0.3);
  }

  .moment :global(.moment__icon) {
    color: var(--green-600);
  }

  /* ---------- Reconnexion ---------- */
  .reconnex {
    display: grid;
    gap: var(--space-7);
    align-items: center;
    padding: clamp(1.5rem, 1rem + 3vw, 4rem);
    background: var(--surface-low);
    border: var(--border);
  }

  .reconnex__visual {
    position: relative;
  }

  .reconnex__img {
    aspect-ratio: 16 / 11;
    border: var(--border);
    box-shadow: var(--shadow-hover);
  }

  .reconnex__badge {
    position: absolute;
    right: 0.5rem;
    bottom: -0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-pill);
    color: var(--green-900);
    box-shadow: var(--shadow);
  }

  .reconnex :global(.reconnex__badge-icon) {
    color: var(--green-600);
  }

  .reconnex__text {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .reconnex__label {
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
    background: rgba(197, 242, 96, 0.3);
    border: 1px solid var(--lime);
  }

  .checks {
    display: grid;
    gap: var(--space-4);
    margin-block: var(--space-2);
  }

  .checks li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    color: var(--ink-2);
  }

  .checks strong {
    color: var(--green-900);
    font-weight: 600;
  }

  .checks__dot {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.1rem;
    border-radius: 50%;
    background: var(--lime);
    color: var(--green-900);
  }

  .reconnex__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  /* ---------- Déroulement ---------- */
  .steps {
    display: grid;
    gap: var(--space-6);
  }

  .step {
    padding: var(--space-6);
  }

  .step__num {
    display: block;
    margin-bottom: var(--space-4);
    font-size: 3.25rem;
    font-weight: 700;
    line-height: 1;
    color: var(--surface-high);
  }

  .step h3 {
    margin-bottom: var(--space-3);
  }

  /* ---------- Prix ---------- */
  .section--tight {
    padding-block: var(--space-8);
  }

  .price {
    position: relative;
    padding: clamp(2rem, 1.5rem + 2.5vw, 3.5rem);
    background: var(--green-800);
    color: var(--on-dark);
    border: 1px solid rgba(194, 200, 193, 0.2);
    box-shadow: 0 25px 50px -12px rgba(8, 32, 19, 0.25);
  }

  .price__glow {
    position: absolute;
    right: -6rem;
    top: -6rem;
    width: 24rem;
    height: 24rem;
    border-radius: 50%;
    background: rgba(197, 242, 96, 0.1);
    filter: blur(64px);
    pointer-events: none;
  }

  .price__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-6);
  }

  .price__text {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    max-width: 40rem;
  }

  .price__pill {
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--lime);
    color: var(--green-900);
  }

  .price__title {
    color: var(--on-dark);
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
  }

  .price__desc {
    font-size: var(--body-lg);
    color: rgba(232, 232, 231, 0.9);
    line-height: 1.55;
  }

  .price__side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .price__amount-label {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--surface-high);
  }

  .price__amount strong {
    font-size: var(--text-display);
