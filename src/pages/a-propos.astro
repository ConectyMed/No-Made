---
/**
 * À propos : la personne qui encadre les sessions, en « je ». Une seule voix sur tout le site.
 * Le parcours vient de ses mots (2026-09-28), rien n'est ajouté. Aucun titre professionnel
 * n'est affiché (sa décision). Reste à fournir : le portrait.
 */
import Base from '@/layouts/Base.astro';
import PageIntro from '@/components/PageIntro.astro';
import PlaceholderImage from '@/components/PlaceholderImage.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import type { IconName } from '@/components/Icon.astro';
import { usePage } from '@/i18n';
import { site, CTA_LABEL, CTA_HREF, VISIO_LABEL, VISIO_HREF } from '@/data/site';

const page = usePage('about');
const firstName = site.ownerFirstName;

// En quelques mots : les faits qu'il a donnés, tels quels.
const facts: { label: string; value: string }[] = [
  { label: 'Voyage', value: '10 ans en autonomie, dans des natures très différentes' },
  { label: 'Terrain', value: 'Connaissance du terrain, adaptation à chaque environnement' },
  { label: 'Pratique', value: 'Jiu-jitsu brésilien, escalade, boxe, préparation physique' },
  { label: 'Langues', value: 'Français, anglais, espagnol' },
];

const practice: { icon: IconName; title: string; text: string }[] = [
  { icon: 'walk', title: 'Marche et randonnée', text: 'Le terrain fait le travail. Un sentier, une montée, un rythme qui s’adapte à toi ou au groupe.' },
  { icon: 'hands', title: 'Préparation physique fonctionnelle', text: 'Au poids du corps, avec ce qu’on trouve dehors. Des mouvements utiles dans la vie de tous les jours.' },
  { icon: 'leaf', title: 'Mobilité', text: 'Inspirée du yoga et du mouvement animal. Pour retrouver de l’amplitude, sans forcer.' },
  { icon: 'wind', title: 'Respiration et concentration', text: 'Des techniques simples pour poser le souffle et l’attention. Souvent le moment qu’on retient.' },
];
---

<Base title={page.title} description={page.description}>
  <PageIntro eyebrow={page.eyebrow} title={page.h1} lead={page.lead} />

  <section class="section section--top0" aria-labelledby="story-title">
    <div class="container story">
      <div class="story__photo frame" data-reveal>
        <PlaceholderImage alt={`portrait de ${firstName} (à fournir)`} ratio="4 / 5" tone="moss" />
      </div>
      <div class="story__text prose" data-reveal style="--reveal-delay: 100ms">
        <h2 id="story-title">Moi, c’est {firstName}</h2>
        <p>
          Nó Made Project, c’est moi : la personne qui t’écrit, qui te répond, et qui t’emmène dehors. Pas de structure
          derrière, pas d’équipe. Un sac, des sentiers, et toi.
        </p>
        <p>
          Dix ans de voyage, sac sur le dos et en autonomie, à traverser des natures très différentes et à apprendre à
          m’adapter à chaque terrain. Des années à rencontrer des gens de tous horizons : ça apprend à écouter, à sentir
          un rythme, à mettre à l’aise. Et depuis toujours, le sport : jiu-jitsu brésilien, escalade, boxe, préparation
          physique. C’est de là que vient ma façon de bouger, et l’envie de la transmettre.
        </p>
        <p>
          Ce que je vois autour de moi, c’est des journées assises, le nez sur un écran, et un corps et une tête qui
          finissent par le payer. Nó Made est né de ça : un rendez-vous pour remettre les deux en mouvement, dehors,
          et redécouvrir ce qui nous entoure. Sortir de la routine, retrouver une bonne condition physique, entretenir
          ce qui nous sert tous les jours : le souffle, la force, l’attention.
        </p>
        <p>
          Je travaille en solo ou en petit groupe, et en duo parent / enfant. Dans tous les cas, je m’adapte à ton
          profil : le rythme, l’intensité, ce qu’on fait et ce qu’on ne fait pas. Je parle français, anglais et
          espagnol, une session peut se faire dans l’une de ces trois langues. Le téléphone, lui, reste dans le sac.
        </p>
        <dl class="story__facts">
          {facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="section section--top0" id="pratique" aria-labelledby="practice-title">
    <div class="container">
      <div class="practice frame" data-reveal>
        <div class="practice__head">
          <span class="eyebrow">Ma façon de faire</span>
          <h2 id="practice-title">Dehors, avec ce qu’on a</h2>
          <p class="lead">Quatre choses reviennent dans chaque session, dans des proportions qui dépendent de toi.</p>
        </div>
        <ul class="practice__list" role="list">
          {practice.map((p) => (
            <li>
              <span class="practice__icon"><Icon name={p.icon} size={22} /></span>
              <div>
                <h3>{p.title}</h3>
                <p class="small muted">{p.text}</p>
              </div>
            </li>
          ))}
        </ul>
        <div class="practice__cta">
          <Button href={CTA_HREF} variant="dark" icon="arrow-right">{CTA_LABEL}</Button>
          <a href={VISIO_HREF} class="practice__link label">{VISIO_LABEL}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .section--top0 {
    padding-top: 0;
  }

  .story {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }

  .story__photo {
    max-width: 22rem;
    border: var(--border);
  }

  .story__text h2 {
    margin-top: 0;
    font-size: var(--text-xl);
    color: var(--green-900);
  }

  .story__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: var(--border);
  }

  .story__facts dt {
    font-size: var(--label-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--green-600);
    margin-bottom: 0.2rem;
  }

  .story__facts dd {
    font-size: var(--body-sm);
    color: var(--ink-2);
    line-height: 1.5;
  }

  .practice {
    display: grid;
    gap: var(--space-7);
    padding: clamp(1.5rem, 1rem + 3vw, 4rem);
    background: var(--surface-low);
    border: var(--border);
  }

  .practice__head {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    max-width: 44rem;
  }

  .practice__list {
    display: grid;
    gap: var(--space-5);
  }

  .practice__list li {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .practice__list h3 {
    font-size: var(--text-sm-h);
    margin-bottom: var(--space-1);
  }

  .practice__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-box);
    background: var(--surface);
    border: var(--border);
    color: var(--green-900);
  }

  .practice__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }

  .practice__link {
    color: var(--green-600);
  }

  @media (min-width: 56em) {
    .story {
      grid-template-columns: 22rem minmax(0, 1fr);
      gap: var(--space-9);
    }

    .practice__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6) var(--space-8);
    }
  }
</style>
