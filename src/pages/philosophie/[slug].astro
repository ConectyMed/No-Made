---
/**
 * Un article de « Ma philosophie ». Rendu à la demande depuis la base, mis en cache une minute.
 * Seuls les articles publiés sont visibles ; un brouillon ou une adresse inconnue répond 404, avec un lien vers la liste
 * (la page 404 du site est statique : Astro refuse d'y réécrire depuis une page rendue à la demande).
 */
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import CtaBand from '@/components/CtaBand.astro';
import { getPublishedArticle } from '@/lib/crm/articles';
import { mediaDims, mediaIdsOf } from '@/lib/crm/media';
import { renderMarkdown, readingMinutes } from '@/lib/markdown';
import { formatDateLong } from '@/lib/dates';
import { site } from '@/data/site';

export const prerender = false;

const slug = Astro.params.slug ?? '';
let article = null;
let dims: Awaited<ReturnType<typeof mediaDims>> = {};
try {
  article = await getPublishedArticle(slug);
  if (article) dims = await mediaDims(mediaIdsOf(article));
} catch (e) {
  console.error('[philosophie] lecture impossible :', e);
  return new Response('Service momentanément indisponible.', { status: 503, headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Cache-Control': 'no-store' } });
}
if (!article) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60');
} else {
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=600');
}
const html = article ? renderMarkdown(article.body, dims) : '';
const cover = article?.coverId ? { src: `/photos/${article.coverId}/`, alt: article.coverAlt ?? '', ...dims[article.coverId] } : null;
const published = article ? (article.publishedAt ?? article.createdAt) : 0;
---

{!article ? (
<Base title="Texte introuvable" noindex>
  <header class="article__head container article__col">
    <a href="/philosophie/" class="article__back label-sm">← Ma philosophie</a>
    <h1>Ce texte n’est plus là</h1>
    <p class="lead">Il a peut-être changé d’adresse ou été retiré. Les autres sont sur la page Ma philosophie.</p>
    <Button href="/philosophie/" variant="dark" icon="arrow-right">Voir les textes</Button>
  </header>
</Base>
) : (
<Base title={article.title} description={article.excerpt ?? `Un texte de ${site.ownerFirstName}, de ${site.name}.`} image={cover?.src}>
  <article class="article">
    <header class="article__head container article__col">
      <a href="/philosophie/" class="article__back label-sm">← Ma philosophie</a>
      <p class="article__meta label-sm">
        <time datetime={new Date(published).toISOString()}>{formatDateLong(published).replace(/^\S+ /, '')}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes(article.body)} min de lecture</span>
      </p>
      <h1>{article.title}</h1>
      {article.excerpt && <p class="lead">{article.excerpt}</p>}
      <p class="article__by small muted">Par {site.ownerFirstName}</p>
    </header>

    {cover && (
      <div class="container article__cover-wrap">
        <img class="article__cover" src={cover.src} alt={cover.alt} width={cover.width} height={cover.height} fetchpriority="high" decoding="async" />
      </div>
    )}

    <div class="container article__col">
      <div class="prose article__body" set:html={html} />
    </div>
  </article>

  <CtaBand title="On en parle dehors ?" headingId="suite-title">
    Une session, c’est ce texte en mouvement : de la marche, du souffle, et le téléphone dans le sac.
  </CtaBand>
</Base>
)}

<style>
  .article__col {
    max-width: calc(var(--prose-max) + 2 * var(--gutter));
  }

  .article__head {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding-block: clamp(2rem, 1.5rem + 3vw, 4rem) var(--space-6);
  }

  .article__cover-wrap {
    max-width: calc(56rem + 2 * var(--gutter));
    margin-bottom: var(--space-7);
  }

  .article__cover {
    display: block;
    width: 100%;
    height: auto;
    max-height: 34rem;
    object-fit: cover;
    border-radius: var(--radius-frame);
    background: var(--surface-low);
  }

  .article__back {
    color: var(--green-600);
    font-weight: 700;
    text-decoration: none;
  }

  .article__back:hover {
    text-decoration: underline;
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--green-600);
  }

  .article__body {
    font-size: var(--body-lg);
    line-height: 1.7;
  }

  .article__body :global(blockquote) {
    padding-left: var(--space-4);
    border-left: 3px solid var(--lime);
    color: var(--green-900);
    font-style: italic;
  }

  .article__body :global(strong) {
    color: var(--ink);
  }

</style>
