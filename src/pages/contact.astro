---
/** Contact / Demande de session : formulaire (pré-rempli via ?experience=slug ou ?session=id), rendez-vous visio, FAQ. */
import Base from '@/layouts/Base.astro';
import PageIntro from '@/components/PageIntro.astro';
import ContactForm from '@/components/ContactForm.astro';
import VisioBooking from '@/components/VisioBooking.astro';
import { usePage } from '@/i18n';
import { site } from '@/data/site';

const page = usePage('contact');

/** "[TEXTE ENTRE CROCHETS]" → marque de placeholder visible (comme sur les cartes d'expérience). */
const parts = (s: string) =>
  s.split(/(\[[^\]]+\])/g).map((p) => (/^\[[^\]]+\]$/.test(p) ? { ph: p.slice(1, -1) } : { text: p }));

const faq: { q: string; a: string; link?: { href: string; label: string } }[] = [
  {
    q: 'Où ont lieu les sessions ?',
    a: `Autour de ${site.zone.replace(' et alentours', '')}, et alentours, sur des sentiers que je choisis selon la saison, ton niveau et le groupe. Le point de rendez-vous exact est précisé par email une fois la date calée.`,
  },
  {
    q: 'Faut-il être sportif ?',
    a: 'Non. Je m’adapte à ton profil : le rythme de marche, l’intensité du travail au poids du corps, la mobilité. On progresse, on ne force pas.',
  },
  {
    q: 'Peut-on venir seul ?',
    a: 'Oui, de deux façons. En solo, c’est une session rien qu’avec moi, construite pour toi. Ou tu rejoins une sortie groupée déjà datée (de trois à cinq personnes), même seul : les dates ouvertes sont sur la page Expériences. La Reconnexion se fait en duo parent / enfant, ou à quatre.',
  },
  {
    q: 'Et si je veux en parler avant de réserver ?',
    a: `Réserve un créneau visio de ${site.visio.duration}, gratuit et sans engagement. On fait le point sur ce que tu cherches, et je te dis ce que je te propose.`,
  },
  {
    q: 'Comment ça se passe pour payer ?',
    a: 'Pas de paiement en ligne. Je confirme la date par email, puis tu règles par lien de paiement ou par virement, [AVANT / APRÈS LA SORTIE : À CONFIRMER]. Les conditions sont dans les CGV.',
  },
  {
    q: 'Comment te joindre le jour de la sortie ?',
    a: 'Une fois ta session confirmée, je te donne mon numéro WhatsApp pour le jour J.',
  },
  {
    q: 'Et s’il pleut ?',
    a: 'On regarde la météo ensemble la veille. Si des intempéries sont annoncées, tu choisis : on maintient si les conditions le permettent, ou on reporte à une autre date, sans frais. En cas de danger (orage, vent violent, risque incendie), je reporte.',
  },
  {
    q: 'Qui encadre, et est-ce que c’est sûr ?',
    a: 'C’est moi qui encadre chaque session, en personne. Je choisis les sentiers selon le niveau et l’âge de chacun, et je prépare chaque sortie. Tout est détaillé sur la page Encadrement et sécurité.',
    link: { href: '/encadrement/', label: 'Encadrement et sécurité' },
  },
  {
    q: 'Qu’est-ce qu’il faut apporter ?',
    a: 'Une tenue confortable, des chaussures fermées, de l’eau, une couche de plus selon la météo. Pour la demi-journée, un encas. Le téléphone reste dans le sac.',
  },
];
---

<Base title={page.title} description={page.description}>
  <PageIntro eyebrow={page.eyebrow} title={page.h1} lead={page.lead} />

  <section class="section section--top0" aria-label="Formulaire de demande">
    <div class="container wrap">
      <ContactForm selected={null} id="demande" />
      <p class="small muted alt">
        Tu préfères écrire directement ? <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </section>

  <section class="section section--top0" aria-label="Rendez-vous visio">
    <div class="container wrap" data-reveal>
      <VisioBooking />
    </div>
  </section>

  <section class="section section--top0" id="faq" aria-labelledby="faq-title">
    <div class="container wrap">
      <div class="section-head">
        <span class="eyebrow">Questions fréquentes</span>
        <h2 id="faq-title">Avant de m’écrire</h2>
      </div>
      <div class="faq">
        {faq.map((item) => (
          <details class="faq__item card">
            <summary class="faq__q">{item.q}</summary>
            <p class="faq__a muted">
              {parts(item.a).map((p) => ('ph' in p ? <mark class="placeholder">[{p.ph}]</mark> : p.text))}
              {item.link && <> <a href={item.link.href}>{item.link.label}</a>.</>}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

</Base>

<style>
  .section--top0 {
    padding-top: 0;
  }

  .wrap {
    max-width: calc(44rem + 2 * var(--gutter));
  }

  .alt {
    margin-top: var(--space-4);
    text-align: center;
  }

  .faq {
    display: grid;
    gap: var(--space-3);
  }

  .faq__item {
    padding: 0 var(--space-5);
  }

  .faq__q {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    min-height: 3.5rem;
    padding-block: var(--space-4);
    font-weight: 600;
    color: var(--green-900);
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q::after {
    content: '+';
    flex: none;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--surface-low);
    color: var(--green-600);
    font-weight: 500;
    transition: transform var(--dur-base) ease;
  }

  .faq__item[open] .faq__q::after {
    transform: rotate(45deg);
  }

  .faq__a a {
    color: var(--green-600);
    font-weight: 600;
  }

  .faq__a {
    padding-bottom: var(--space-5);
    max-width: 60ch;
  }
</style>
