---
import Base from '@/layouts/Base.astro';
import PageIntro from '@/components/PageIntro.astro';
import Button from '@/components/Button.astro';
import { usePage } from '@/i18n';

const page = usePage('notFound');
---

<Base title={page.title} description={page.description} noindex>
  <PageIntro title={page.h1} lead={page.lead} align="center">
    <div class="actions">
      <Button href="/" variant="dark" icon="arrow-right">{page.backHome}</Button>
      <Button href="/offres/" variant="outline">Voir les offres</Button>
    </div>
  </PageIntro>
</Base>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
    padding-bottom: var(--space-10);
  }
</style>
