---
/** Gabarit des trois pages légales (/mentions-legales, /cgv, /confidentialite). Contenu au jalon M4. */
import Base from './Base.astro';
import { legalLinks } from '@/data/site';

interface Props {
  title: string;
  description: string;
  h1: string;
  updated?: string;
}

const { title, description, h1, updated } = Astro.props;
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<Base {title} {description}>
  <div class="container legal">
    <nav class="legal__nav" aria-label="Pages légales">
      <ul role="list">
        {
          legalLinks.map((l) => (
            <li>
              <a href={l.href} aria-current={(l.href.replace(/\/+$/, '') || '/') === current ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <article class="legal__body prose">
      <h1>{h1}</h1>
      {updated && <p class="small muted">Dernière mise à jour : {updated}</p>}
      <slot />
    </article>
  </div>
</Base>

<style>
  .legal {
    display: grid;
    gap: var(--space-6);
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) var(--section);
  }

  .legal__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .legal__nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding: 0 1rem;
    border-radius: var(--radius-pill);
    border: var(--border);
    background: var(--surface);
    font-size: var(--label-sm);
    font-weight: 600;
    color: var(--ink-2);
    text-decoration: none;
  }

  .legal__nav a[aria-current='page'] {
    color: var(--green-900);
    border-color: var(--outline);
  }

  .legal__body h1 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }

  @media (min-width: 56em) {
    .legal {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: var(--space-9);
      align-items: start;
    }

    .legal__nav {
      position: sticky;
      top: var(--header-offset);
    }

    .legal__nav ul {
      flex-direction: column;
    }
  }
</style>
